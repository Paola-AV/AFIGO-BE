## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# VS Code
.vscode/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider IDE
.idea/

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core Environment config
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json

# Sensitive config files
*.env
*.key
*.pem
*.pfx
*.cert

# Publish output
out/
publish/

# Logs
*.log

# Database / backups
*.mdf
*.ldf
*.sqlite
*.db

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Others
*.tmp
*.temp
*.cache
*.pid
*.swp